    skos:altLabel """rédiger du contenu écrit
proposer du contenu écrit
fournir du contenu rédigé professionnellement
fournir du texte écrit
mettre à disposition du contenu écrit
offrir du contenu écrit"""@fr ;
    skos:definition "Communiquer des informations sous forme écrite, sur des supports numériques ou imprimés, en fonction des besoins du groupe cible. Structurer le contenu conformément à des spécifications et des normes. Appliquer des règles grammaticales et orthographiques."@fr ;
    skos:narrower <http://www.example.com/cmo/skill/03589d0d-a6f0-4d68-b5eb-dafbc6833efe>,
        <http://www.example.com/cmo/skill/c3c2420c-ce9a-4371-8eed-1db479c3a562> ;
    skos:prefLabel "fournir du contenu écrit"@fr .

