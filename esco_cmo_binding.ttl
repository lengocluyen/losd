<http://www.example.com/cmo/skill/79593e17-a63e-41bf-8f2f-ee9fd86df8a1> a cmo:Skill ;
    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/92231a03-010b-45cc-83a0-aa6491a3c6f3> ;
