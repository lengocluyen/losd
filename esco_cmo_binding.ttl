    skos:prefLabel "entendre des témoignages"@fr .

<http://www.example.com/cmo/skill/a1fea64a-8400-492e-87cb-8f7019df6bef> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Créer des arrangements de végétaux avec des plantes intérieures ou extérieures afin de délimiter un jardin régulier ou paysager ou de les utiliser pour des corbeilles suspendues, des contenant pour plantation ou des murs de végétaux intérieurs."@fr ;
    skos:prefLabel "créer des arrangements de végétaux"@fr .

<http://www.example.com/cmo/skill/a208a63d-caca-49c6-ac65-e6aba0d8ebb1> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
