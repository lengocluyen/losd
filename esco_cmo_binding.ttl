<http://www.example.com/cmo/skill/6b305973-8993-475f-bd8a-daf037c61401> a cmo:Skill ;
    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/57231a22-4da7-49c8-97b8-75672feadf1e>,
        <http://www.example.com/cmo/skill/9af1bd12-01bd-4d6a-947b-69e64f23150a> ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
