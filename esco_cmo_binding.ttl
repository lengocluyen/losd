    skos:prefLabel "déterminer qui est l’auteur d’un document"@fr .

<http://www.example.com/cmo/skill/691c7db6-bad8-4a09-a3c4-4bf799375a35> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
