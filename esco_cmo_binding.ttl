    skos:prefLabel "utiliser une caisse enregistreuse"@fr .

<http://www.example.com/cmo/skill/0cb35854-7d5e-4f88-83a4-64431cfe58ca> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Élaborer un plan global de conservation complet et de haut niveau pour la collecte."@fr ;
    skos:prefLabel "créer un plan de conservation de la collection"@fr .

<http://www.example.com/cmo/skill/0cd07ad3-642c-4073-812f-3842dffcd920> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
