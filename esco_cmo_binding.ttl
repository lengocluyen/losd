    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Respecter les règles, les politiques et les lois qui régissent les activités de transport et de distribution."@fr ;
    skos:narrower <http://www.example.com/cmo/skill/200a8387-d67c-43e4-9cdc-44ab592c299e> ;
