    skos:prefLabel "vendre des articles vestimentaires à des clients"@fr .

<http://www.example.com/cmo/skill/99095ca0-1218-462d-9e95-79e334ba8b63> a cmo:Skill ;
    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/09276365-d4a2-45d0-a5c6-3b25e306f6d9>,
        <http://www.example.com/cmo/skill/0a71a150-17fd-448e-a5b8-19fbea76d569> ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Interpréter les données provenant des études sur les transports traitant de la planification, de la gestion, des opérations et de l’ingénierie des transports."@fr ;
    skos:narrower <http://www.example.com/cmo/skill/09276365-d4a2-45d0-a5c6-3b25e306f6d9>,
