<http://www.example.com/cmo/skill/7c5b66c6-36a1-4e03-bb57-64e8688b8f58> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel """faire fonctionner un autocommutateur téléphonique privé
utiliser un IPBX
faire fonctionner un PBX
utiliser un standard téléphonique interne
utiliser un PABX
utiliser un PABX-IP"""@fr ;
    skos:definition "Gérer le commutateur téléphonique privé (PBX), un système de télécommunication au sein d’une organisation qui transmet les appels entre les utilisateurs sur les lignes locales. Dans le même temps, le système permet à tous les utilisateurs de partager des lignes téléphoniques externes."@fr ;
    skos:prefLabel "faire fonctionner un commutateur téléphonique privé"@fr .

<http://www.example.com/cmo/skill/7c632656-361e-4db1-8d69-b9f85d6be0d0> a cmo:Skill ;
