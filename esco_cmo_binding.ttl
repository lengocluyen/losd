    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Traduire le dialogue entre deux intervenants et les discours dans un texte écrit, à l’oral ou dans une langue des signes, dans votre langue maternelle ou dans une langue étrangère."@fr ;
    skos:narrower <http://www.example.com/cmo/skill/321f7ade-ba43-4923-a432-54df75ec80a5>,
        <http://www.example.com/cmo/skill/8b5962d7-b195-4459-addb-d15a48cc4b64>,
        <http://www.example.com/cmo/skill/92d04a10-eff2-4190-b5da-85e419f8ebbd> ;
