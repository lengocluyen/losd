    skos:prefLabel "vendre des billets de train"@fr .

<http://www.example.com/cmo/skill/21bcdc7c-6153-414a-b478-eeca2db2fea6> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
