<http://www.example.com/cmo/skill/783ab646-4ccd-4058-a512-152ba6c00582> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel """technique de camouflage
