    skos:prefLabel "améliorer l'interaction avec les clients"@fr .

<http://www.example.com/cmo/skill/8fd5cc16-8d8a-4ae4-b557-9847207e9483> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
