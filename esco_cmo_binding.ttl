    skos:prefLabel "différents types de sable"@fr .

<http://www.example.com/cmo/skill/87669743-a291-4ea0-9a50-cac60d45649c> a cmo:Skill ;
    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/61ba0c31-a54e-49e9-9e9e-c2035d3f3e11> ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel "réadaptation"@fr ;
    skos:definition "Les méthodes et les procédures utilisées pour aider une personne malade ou blessée à récupérer ses compétences perdues et à retrouver autonomie et contrôle."@fr ;
    skos:narrower <http://www.example.com/cmo/skill/61ba0c31-a54e-49e9-9e9e-c2035d3f3e11> ;
    skos:prefLabel "rééducation"@fr .

<http://www.example.com/cmo/skill/876b2ab8-fc63-4643-ba12-c952df6a3abd> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Serrer les bouchons percés et filetés dans la base de bombes aériennes. Insérer les manchons métalliques autour du projectile et emballer le produit dans des récipients métalliques avec les données d’identification supplémentaires."@fr ;
    skos:prefLabel "assembler des bombes"@fr .

<http://www.example.com/cmo/skill/8770350e-746f-4adb-9556-18ca68104be6> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Les procédés, techniques et objectifs qui constituent la première étape de l’élaboration de stratégies de commercialisation telles que la collecte d’informations sur les clients et la définition des segments et des cibles."@fr ;
    skos:prefLabel "étude de marché"@fr .

<http://www.example.com/cmo/skill/877057bc-7be8-4d40-9bab-cda10eb4b999> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Rédiger des textes en grec ancien."@fr ;
