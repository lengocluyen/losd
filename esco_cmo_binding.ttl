<http://www.example.com/cmo/skill/b9e08c07-4a52-4448-84dc-8a2df0601239> a cmo:Skill ;
    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/536132d6-cfc2-4f20-8c8e-4ab8e5ce79e1>,
