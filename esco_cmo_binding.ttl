<http://www.example.com/cmo/skill/2b5143f9-107b-4be2-ae24-7e379ee90369> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Identifier et développer des stratégies visant à étendre la couverture régionale de l’entreprise."@fr ;
