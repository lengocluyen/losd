    skos:narrower <http://www.example.com/cmo/skill/08e2ff26-88ff-47b5-9d37-d19ace01b075>,
        <http://www.example.com/cmo/skill/125258b2-23c1-472c-90c6-4ec2e90ed893>,
        <http://www.example.com/cmo/skill/28d715e3-3e5b-4fb6-8dd2-4be4919c8587>,
        <http://www.example.com/cmo/skill/58fcd942-3019-4498-b685-6b2727b37031>,
        <http://www.example.com/cmo/skill/71746a0b-e58d-4dc4-ad03-bd84082eae21> ;
    skos:prefLabel "accepter les critiques et les directives"@fr .

<http://www.example.com/cmo/skill/05bc7677-5a64-4e0c-ade3-0140348d4125> a cmo:Skill ;
    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/5f6e56b0-7cf7-42b2-9a3f-524ba0774881>,
        <http://www.example.com/cmo/skill/69bbd200-b404-402d-9d1d-69bc066e22cb>,
