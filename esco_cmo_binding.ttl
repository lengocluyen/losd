    skos:prefLabel "assembler des tonneaux"@fr .

<http://www.example.com/cmo/skill/e6e7061f-8211-455a-9a65-adaab3f1f6a1> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel "reprise de possession"@fr ;
