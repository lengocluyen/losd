<http://www.example.com/cmo/skill/19bf4dd0-db65-4484-aa9d-0dcbc2e5dd13> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel "travailler au sein d’équipes multidisciplinaires dans les soins d’urgence"@fr ;
