    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Utiliser des équipements tels que le moniteur, la souris, le clavier, les unités de stockage, les imprimantes, les scanners, etc., pour effectuer des opérations telles que le branchement, le démarrage, la fermeture, le redémarrage, la sauvegarde de fichiers et d’autres opérations."@fr ;
    skos:narrower <http://www.example.com/cmo/skill/71dde84c-0058-4c52-a556-523369333db8>,
        <http://www.example.com/cmo/skill/aba363e7-07ec-4eb2-a89e-bcba397c25ab> ;
