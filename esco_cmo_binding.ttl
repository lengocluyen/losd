<http://www.example.com/cmo/skill/2a8834b9-33a6-4abf-b0a4-219925a331bd> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Utiliser une scie à ruban, une scie industrielle qui présente une lame souple continue qui tourne autour de deux ou plusieurs roues."@fr ;
