<http://www.example.com/cmo/skill/2ffc7a73-7e1d-434a-b498-2b0c056ced1d> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Évaluer, planifier, faciliter, coordonner et défendre des options et des services pour le compte d’une personne."@fr ;
