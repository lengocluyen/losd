    skos:prefLabel "concevoir des électroaimants"@fr .

<http://www.example.com/cmo/skill/8c37d032-7b5b-47e7-bf06-6bafa30ce643> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
