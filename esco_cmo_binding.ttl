<http://www.example.com/cmo/skill/72b90d26-b881-4984-a542-9c47bd42e549> a cmo:Skill ;
    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/be64a688-37ae-4124-8eee-1aec483cce33>,
