<http://www.example.com/cmo/skill/c3102a5f-dafd-417c-8210-1eb779a05448> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Les recommandations quotidiennes de l’apport alimentaire en matière de planification alimentaire et la manière dont les nutriments jouent un rôle important dans la promotion de la santé et du fonctionnement optimal."@fr ;
