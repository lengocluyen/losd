    skos:prefLabel "réaliser des soins esthétiques"@fr .

<http://www.example.com/cmo/skill/83934f53-5ffa-478f-9f8f-b779e9b4fc7a> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
