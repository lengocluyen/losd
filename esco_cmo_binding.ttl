    skos:prefLabel "organiser les informations sur la disponibilité d’une équipe"@fr .

<http://www.example.com/cmo/skill/d3e36164-79aa-4f14-9a8c-d88d38f84ea0> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
