        <http://www.example.com/cmo/skill/fa64c52c-08cf-4074-bc9b-a93075802166> ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Le domaine d’étude qui analyse les relations entre différents environnements et la population et examine les caractéristiques sociales, politiques et économiques des sociétés humaines ainsi que les propriétés morphologiques de la Terre."@fr ;
    skos:narrower <http://www.example.com/cmo/skill/7d594881-a9b4-4d4c-8a8b-75082c136b78>,
        <http://www.example.com/cmo/skill/fa64c52c-08cf-4074-bc9b-a93075802166> ;
    skos:prefLabel "géographie"@fr .

<http://www.example.com/cmo/skill/cf9e867f-08d7-48a8-8d11-c63bd8a65f89> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Rédiger des textes en arabe."@fr ;
    skos:prefLabel "écrire en arabe"@fr .

<http://www.example.com/cmo/skill/cfa0114b-01e8-43ca-ad0f-eea07adc27c9> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Suivre les mouvements de stocks à partir du moment où les produits sont mis en vente et prêts à être distribués."@fr ;
    skos:prefLabel "surveiller des mouvements de stocks"@fr .

<http://www.example.com/cmo/skill/cfa2be0d-96d5-4017-a866-962efb9c5070> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel """processeurs de signal numérique
TNS
transmission de données
processeurs de traitement numérique du signal
traitement numérique du signal
DSP"""@fr ;
    skos:definition "Les algorithmes, applications et mises en œuvre qui traitent du traitement et du transfert d’informations par des fréquences analogiques ou numériques."@fr ;
    skos:prefLabel "traitement du signal"@fr .

<http://www.example.com/cmo/skill/cfb217bd-674c-4728-a8d7-f35fccc4d173> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel """viande cachère
viande kasher"""@fr ;
    skos:definition "La préparation et les type de consommable carné conformément aux lois juives, tel que la viande de poulet et de bœuf."@fr ;
    skos:prefLabel "viande casher"@fr .

<http://www.example.com/cmo/skill/cfb42595-f14e-4f4f-aac8-c782c8a1f075> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Les processus de production liés à la fabrication de cordages industriels tels que les cordages, les cordes de gréement, les fils et les filets. Les conditions de fabrication des produits résistants et de haute qualité, compte tenu de leur usage intensif."@fr ;
    skos:prefLabel "confection de tresses industrielles"@fr .

<http://www.example.com/cmo/skill/cfbde1b6-8e47-4b83-b430-3d5f7f38d69a> a cmo:Skill ;
