    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/02058de6-4b98-449f-8a45-8588b0eb2446> ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel "informatique"@fr ;
    skos:definition "Ordinateurs, réseaux informatiques et autres technologies et équipements de conservation, de récupération, de transmission et de manipulation des données."@fr ;
