    skos:prefLabel "préparer le planning des séchoirs"@fr .

<http://www.example.com/cmo/skill/7d874411-d555-4320-8356-6f7715c15ef5> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Réaliser des tests de diagnostic d’allergies pour détecter les allergies aux médicaments, aux vaccins ou à d’autres substances utilisées dans le traitement médical."@fr ;
    skos:prefLabel "réaliser des tests de diagnostic d’allergies"@fr .

<http://www.example.com/cmo/skill/7d895bdf-bc85-4513-a1e0-7d14fb2861eb> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
