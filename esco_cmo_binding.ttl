    skos:prefLabel "effectuer des opérations financières"@fr .

<http://www.example.com/cmo/skill/4e7776b9-ceef-400a-a1fc-14969c30d233> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Acheter ou vendre des contrats à terme sur le marché à terme, pour votre propre compte ou pour le compte d’un client ou d’une institution, afin de réaliser un bénéfice."@fr ;
    skos:prefLabel "négocier des contrats à terme"@fr .

<http://www.example.com/cmo/skill/4e7b2c61-aa42-404c-995f-32281b818923> a cmo:Skill ;
    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/16d61c6a-30e8-49e2-abbb-d20879eb8afd> ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Avoir conscience de votre position et de l’espace qui vous entoure. Comprendre la relation d’objets autour de vous en cas de changement de position."@fr ;
