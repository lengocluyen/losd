    skos:prefLabel "fabriquer des textiles d’ameublement"@fr .

<http://www.example.com/cmo/skill/69bece91-c806-42ad-bde4-db28c7f8fc4b> a cmo:Skill ;
    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/bf419e00-8548-491a-a06f-d72ab439df2f> ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Systèmes mécaniques, y compris engins, moteurs, systèmes hydrauliques et pneumatiques. Leurs fonctions et défauts probables."@fr ;
