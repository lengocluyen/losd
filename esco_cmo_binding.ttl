<http://www.example.com/cmo/skill/6a0aab53-6246-41e8-a910-e7a13f314860> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel "tester les opérations des infrastructure de pipelines"@fr ;
