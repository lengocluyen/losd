<http://www.example.com/cmo/skill/25b291b5-8245-4d9d-b391-86a8a31d7109> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel """employer la programmation concurrente
utiliser programmation concurrente
utiliser la programmation parallèle
recourir à la programmation concurrente
