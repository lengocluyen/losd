    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Types de matériaux de plâtrage selon leur teneur en différents composants tels que le gypse, le ciment et la chaux, présentant chacun leurs propres propriétés, leurs cas d’utilisation et leur coût."@fr ;
    skos:prefLabel "types de matériaux de plâtrage"@fr .

<http://www.example.com/cmo/skill/43dfbe7f-9e10-4871-b171-e5076737b4cf> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
