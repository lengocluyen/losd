<http://www.example.com/cmo/skill/4ee4ed1d-dc38-48e0-a9e6-a6b64f316ea6> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Le cadre des politiques, stratégies, institutions et réglementations relatives à l’eau."@fr ;
