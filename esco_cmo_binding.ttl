<http://www.example.com/cmo/skill/c4b3bbb4-a4f7-467f-8e91-a545d0224dce> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Les types de chaînes, tels que la chaîne industrielle, la chaîne fantaisie et la chaîne de joaillerie."@fr ;
