<http://www.example.com/cmo/skill/b1b118c4-3291-484e-b64d-6d51fd5da8b3> a cmo:Skill ;
    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/b589ce7c-588f-4045-be2d-9332c2d2278d> ;
