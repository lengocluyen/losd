    skos:prefLabel "systèmes mécaniques"@fr .

<http://www.example.com/cmo/skill/69c05210-9738-4757-8bb3-2e40f0244b56> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Types de techniques d’entretien et impact de différents types d’armes à feu et d’autres armes."@fr ;
    skos:prefLabel "entretien des munitions"@fr .

<http://www.example.com/cmo/skill/69c0689f-09dc-45a8-bc8e-4952b19f7df2> a cmo:Skill ;
    cmo:hasImmediateSubCompetence <http://www.example.com/cmo/skill/19115dcc-8b12-4155-8c46-20ce4e9ec74f>,
        <http://www.example.com/cmo/skill/ec3d6423-8c36-4451-893e-95b4a6a026fb> ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Les caractéristiques des divers matériaux et méthodes utilisés pour graver quelque chose sur une surface."@fr ;
    skos:narrower <http://www.example.com/cmo/skill/19115dcc-8b12-4155-8c46-20ce4e9ec74f>,
        <http://www.example.com/cmo/skill/ec3d6423-8c36-4451-893e-95b4a6a026fb> ;
