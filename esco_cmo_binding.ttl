    skos:prefLabel "technologies en libre-service dans le tourisme"@fr .

<http://www.example.com/cmo/skill/8394fefb-f62a-48c0-a156-3117cefdb9b3> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
