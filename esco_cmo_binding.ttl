<http://www.example.com/cmo/skill/e9867780-9584-43a9-af10-8eb730b525cc> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Contrôler la zone de dynamitage pour vérifier si tous les explosifs ont explosé en toute sécurité; indiquer que la zone de dynamitage est sans danger."@fr ;
    skos:prefLabel "examiner une zone après un dynamitage"@fr .

