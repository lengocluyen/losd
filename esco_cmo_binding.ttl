<http://www.example.com/cmo/skill/c89a3068-fe2d-404a-b505-eeeee71b3da0> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel "gérer des activités d’agrotourisme"@fr ;
