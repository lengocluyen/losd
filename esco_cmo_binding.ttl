    skos:prefLabel "adresse au tir"@fr .

<http://www.example.com/cmo/skill/834b0f0e-2fab-43d3-be21-63681d74b3f1> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
