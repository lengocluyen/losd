    skos:prefLabel "contrôler des ingrédients en poudre"@fr .

<http://www.example.com/cmo/skill/dd0e44b9-b285-4563-8ffc-1d4d96bf548c> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
