    skos:prefLabel "élaborer des politiques économiques"@fr .

<http://www.example.com/cmo/skill/839f83c2-e9fc-4633-9795-601fcbd99c72> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
