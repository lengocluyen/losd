<http://www.example.com/cmo/skill/8ab0f769-f06e-4d57-ba9c-1470230236d4> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Appliquer des traitements prescrits à des poissons sous surveillance, y compris l’assistance aux procédures d’immersion et d’injection de la vaccination."@fr ;
