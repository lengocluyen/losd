        <http://www.example.com/cmo/skill/de4ae0ae-0c82-4295-a724-8c0a27ea1a05> ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Répondre de manière appropriée aux cas d’urgence en matière de nettoyage des rues, après un accident, une manifestation ou une forte chute de neige."@fr ;
