    skos:prefLabel "utiliser des outils mathématiques pour la gestion de véhicules"@fr .

<http://www.example.com/cmo/skill/78e89833-f27e-48db-a885-00d881bdc431> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
