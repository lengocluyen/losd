    skos:definition "Réserver des restaurants, des hôtels ou des vols."@fr ;
    skos:prefLabel "prendre des réservations"@fr .

<http://www.example.com/cmo/skill/fdc83a3b-0ea5-4c2e-af42-8cc0ffce5670> a cmo:Skill ;
