<http://www.example.com/cmo/skill/e4f6279f-2ae3-49bd-b0ab-b8d6b86c38a1> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:definition "Manipuler ou modifier la structure des matériaux en les refroidissant ou en les immergeant dans l’eau."@fr ;
