<http://www.example.com/cmo/skill/5077e3ef-6c80-46be-b944-3d8243350ea1> a cmo:Skill ;
    cmo:inFramework <http://www.example.com/cmo/framework/ESCO> ;
    skos:altLabel "procédés de mouture de céréales destinées à la fabrication de boissons"@fr ;
